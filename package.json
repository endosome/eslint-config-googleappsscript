{
  "name": "@endosome/eslint-config-googleappsscript",
  "version": "1.0.1",
  "description": "Shared ESLint 10 flat config for Google Apps Script projects, built on @endosome/eslint-config-node",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "google-apps-script",
    "apps-script",
    "clasp"
  ],
  "license": "MIT",
  "author": "endosome",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endosome/eslint-config-googleappsscript.git"
  },
  "bugs": "https://github.com/endosome/eslint-config-googleappsscript/issues",
  "homepage": "https://github.com/endosome/eslint-config-googleappsscript#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "globals.js",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "node scripts/generate-globals.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@endosome/eslint-config-node": "1.0.0",
    "globals": "17.13.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "devDependencies": {
    "@types/google-apps-script": "2.0.13",
    "eslint": "10.12.0",
    "typescript": "6.0.3"
  }
}
